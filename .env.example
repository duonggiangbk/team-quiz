# Upstash Redis (Vercel Storage → Upstash for Redis sets these automatically).
# Leave empty to store question sets only in the browser (localStorage).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Required for assignments/reports; optional for editing shared question sets.
EDIT_PIN=

# Google sign-in is optional. AUTH_URL is the site's origin, without a path.
AUTH_URL=http://localhost:3000
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Gemini API key stays on the server. Upstash is required for the AI usage limit.
GEMINI_API_KEY=
# Optional: override the default Gemini model if available to your account.
GEMINI_MODEL=
